# ── Stage 1: Build ──
FROM node:25-slim AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

# NOTE: PUBLIC_API_BASE_URL is deliberately NOT set here. The frontend uses
# SvelteKit's $env/dynamic/public, which reads env vars at runtime from the
# running Node process, not at build time. The value is injected via the
# frontend service's environment block in deploy/podman-compose.yml.

# SvelteKit's post-build analysis imports server modules, which require DATABASE_URL to not crash.
# This is never used for an actual connection — the runtime container gets the real URL from compose.
ENV DATABASE_URL=postgres://unused:unused@build-only:5432/unused
RUN npm run build

# ── Stage 2: Runtime ──
FROM node:25-slim

RUN groupadd -r llmhub && useradd -r -g llmhub -m llmhub

WORKDIR /app

# adapter-node outputs to /app/build by default
COPY --from=builder /app/build ./build
COPY --from=builder /app/package.json .
COPY --from=builder /app/node_modules ./node_modules

COPY deploy/frontend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN chown -R llmhub:llmhub /app
USER llmhub

ENV NODE_ENV=production \
    PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:3000').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
